ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Full power Image → Tree (copy block into .env.local) ---
ANTHROPIC_USE_STRUCTURED_OUTPUTS=1
ANTHROPIC_MAX_TOKENS=8192
LAYOUT_SERVICE_URL=http://localhost:8090
LAYOUT_SERVICE_ENABLED=1
LAYOUT_SERVICE_TIMEOUT_MS=45000
RECONSTRUCTION_MULTI_REGION_COMPARE=1
MCP_UI_TOOLS_URL=https://mcp.shopalyst.com/ui-tools/mcp
# PUBLIC_BASE_URL=https://YOUR-TUNNEL.example.com

# Shopalyst ui-tools MCP (background removal)
MCP_UI_TOOLS_URL=https://mcp.shopalyst.com/ui-tools/mcp
# MCP_UI_TOOLS_HEALTH_URL=https://mcp.shopalyst.com/ui-tools/mcp/healthCheck

# Base URL where /runs/... images are reachable by MCP (required for bg removal on local dev — use ngrok/tunnel)
# PUBLIC_BASE_URL=https://your-tunnel.example.com
PORT=8787
