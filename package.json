{
  "name": "design-tree-pipeline-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Image → Design Tree pipeline (JavaScript). Includes crop + JS/Playwright renderer + vision compare loop.",
  "bin": {
    "design-tree-pipeline-js": "bin/run.js"
  },
  "scripts": {
    "setup": "npm install && npm run setup-browser && npm run setup-remotion",
    "setup-browser": "npx playwright install chromium",
    "setup-remotion": "cd remotion && npm install && npm run build",
    "build:remotion": "cd remotion && npm run build",
    "ui": "node server.js",
    "render:png": "node scripts/render-to-png.mjs --help",
    "run": "node bin/run.js",
    "test:ad-template": "node bin/test-ad-template.js",
    "test:ad-template:full": "node bin/test-ad-template.js --full",
    "test:reconstruction-golden": "node bin/test-reconstruction-golden.js",
    "test:product-bbox": "node bin/test-product-bbox.js",
    "test:layout-merge": "node bin/test-layout-merge.js",
    "test:design-tree-editor": "node bin/test-design-tree-editor.js",
    "benchmark:reconstruction": "node bin/benchmark-reconstruction.js",
    "check:setup": "node bin/check-setup.js",
    "test:llm-schemas": "node bin/test-llm-schemas.js",
    "setup:layout-service": "cd layout-service && python3 -m pip install -r requirements.txt",
    "layout-service": "cd layout-service && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8090"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "moveable": "^0.53.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.46.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  }
}

